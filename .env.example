# === Telegram ===
BOT_TOKEN=your_bot_token_here

# Список ID администраторов (через запятую)
ADMIN_IDS=123456789,987654321

# Юзернейм для отображения в разделе помощи
ADMIN_USERNAME=your_admin_username

# === PostgreSQL ===
DB_HOST=postgres
DB_PORT=5432
DB_NAME=bot_4_shazam
DB_USER=bot_user
DB_PASSWORD=changeme

# === yt-dlp: цепочка прокси для скачивания трека ===
# Порядок: residential SOCKS5 → WARP → direct
# (если предыдущий вариант упал — пробуем следующий)
# WARP поднимается в docker-compose автоматически и используется всегда.

# Резидентный SOCKS5 прокси (приоритет 1)
PROXY_URL=socks5://user:pass@host:port

# === Параметры распознавания ===
# Максимальный размер входящего файла (МБ)
MAX_INPUT_MB=20

# Длина аудиосэмпла для отправки в Shazam (секунды)
SAMPLE_DURATION=15
